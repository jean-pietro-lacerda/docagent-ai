APP_NAME=DocAgent AI
DEBUG=false
STORAGE_DIR=var/documents
AUTH_ENABLED=false
REGISTRATION_ENABLED=false
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
JWT_ISSUER=docagent-ai
# JWT_AUDIENCE=docagent-api
JWT_ACCESS_TOKEN_MINUTES=30
DATABASE_URL=postgresql+psycopg://docagent:REPLACE_WITH_DATABASE_PASSWORD@localhost:5432/docagent_ai
EMBEDDINGS_CACHE_DIR=~/.cache/docagent-ai/models
# Configure manualmente para habilitar geração. Nenhuma chamada é feita na inicialização.
# GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY
# GROQ_MODEL=YOUR_AVAILABLE_MODEL_ID
GROQ_TIMEOUT_SECONDS=20
GROQ_MAX_OUTPUT_TOKENS=768
RAG_CONTEXT_CHARACTERS=12000
# RAG_MIN_SCORE é mantido por compatibilidade; o cosseno apenas ordena candidatos.
